              "FA20D_Compose_JoinUrlAnchorIndex": {"type": "Compose", "inputs": "@indexOf(coalesce(outputs('FA19_Compose_SelectedEvent')?['body'], ''), 'href=\"https://teams.microsoft.com/')", "runAfter": {"FA20B_Compose_OutBodyPreview": ["Succeeded"]}},
              "FA20E_Compose_JoinUrlFromAnchor": {"type": "Compose", "inputs": "@if(equals(outputs('FA20D_Compose_JoinUrlAnchorIndex'), -1), '', substring(coalesce(outputs('FA19_Compose_SelectedEvent')?['body'], ''), add(outputs('FA20D_Compose_JoinUrlAnchorIndex'), 6), sub(length(coalesce(outputs('FA19_Compose_SelectedEvent')?['body'], '')), add(outputs('FA20D_Compose_JoinUrlAnchorIndex'), 6))))", "runAfter": {"FA20D_Compose_JoinUrlAnchorIndex": ["Succeeded"]}},
              "FA20F_Compose_JoinUrlExtracted": {"type": "Compose", "inputs": "@if(equals(outputs('FA20E_Compose_JoinUrlFromAnchor'), ''), '', substring(outputs('FA20E_Compose_JoinUrlFromAnchor'), 0, if(equals(indexOf(outputs('FA20E_Compose_JoinUrlFromAnchor'), '\"'), -1), length(outputs('FA20E_Compose_JoinUrlFromAnchor')), indexOf(outputs('FA20E_Compose_JoinUrlFromAnchor'), '\"'))))", "runAfter": {"FA20E_Compose_JoinUrlFromAnchor": ["Succeeded"]}},
              "FA20C_Compose_OutOnlineMeetingUrl": {"type": "Compose", "inputs": "@if(empty(coalesce(outputs('FA19_Compose_SelectedEvent')?['onlineMeeting']?['joinUrl'], '')), outputs('FA20F_Compose_JoinUrlExtracted'), outputs('FA19_Compose_SelectedEvent')?['onlineMeeting']?['joinUrl'])", "runAfter": {"FA20F_Compose_JoinUrlExtracted": ["Succeeded"]}},
