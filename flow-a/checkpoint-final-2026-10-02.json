  "Scope_Resolve": {
    "type": "Scope",
    "actions": {
      "FA15_Compose_IsSelectionMode": {
        "type": "Compose",
        "inputs": "@and(not(empty(trim(variables('varInSelectedNumber')))), not(contains(createArray('NONE','P','N','C'), toUpper(trim(variables('varInSelectedNumber'))))))"
