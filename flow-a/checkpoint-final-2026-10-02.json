              "FA19C_Compose_OutSeriesMasterId_Resolved": {"type": "Compose", "inputs": "@coalesce(outputs('FA19_Compose_SelectedEvent')?['seriesMasterId'], '')", "runAfter": {"FA19B_Compose_OutIsRecurring_Resolved": ["Succeeded"]}},
              "FA22_Compose_OutMatchCount_Resolved": {"type": "Compose", "inputs": 1, "runAfter": {"FA19C_Compose_OutSeriesMasterId_Resolved": ["Succeeded"]}},
              "FA23_Compose_OutCandidateList_Resolved": {"type": "Compose", "inputs": "@string('')", "runAfter": {"FA22_Compose_OutMatchCount_Resolved": ["Succeeded"]}}
