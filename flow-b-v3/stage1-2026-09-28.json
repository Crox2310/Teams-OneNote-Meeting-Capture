  "Scope_Normalize": {
    "type": "Scope",
    "actions": {
      "NZ01_Compose_IsRecurring": {
        "type": "Compose",
        "inputs": "@if(empty(trim(coalesce(triggerBody()?['text_1'], ''))), 'false', 'true')"
      },
      "NZ02_Compose_MappingKey": {
        "type": "Compose",
        "inputs": "@if(equals(outputs('NZ01_Compose_IsRecurring'), 'true'), triggerBody()?['text_1'], triggerBody()?['text_6'])",
        "runAfter": { "NZ01_Compose_IsRecurring": ["SUCCEEDED"] }
      },
      "NZ03_Compose_SectionName": {
        "type": "Compose",
        "inputs": "@if(equals(outputs('NZ01_Compose_IsRecurring'), 'true'), if(empty(trim(coalesce(triggerBody()?['text'], ''))), 'Mtg - Untitled Meeting', concat('Mtg - ', substring(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(coalesce(triggerBody()?['text'], ''), '/', '-'), ':', '-'), '&', 'and'), '?', ''), '*', ''), '<', ''), '>', ''), '\"', ''), '|', ''), '#', ''), '''', ''), '%', ''), '~', ''), 0, min(43, length(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(coalesce(triggerBody()?['text'], ''), '/', '-'), ':', '-'), '&', 'and'), '?', ''), '*', ''), '<', ''), '>', ''), '\"', ''), '|', ''), '#', ''), '''', ''), '%', ''), '~', '')))))), 'One Off meetings')",
        "runAfter": { "NZ02_Compose_MappingKey": ["SUCCEEDED"] }
      },
      "NZ04_Compose_OccurrenceDateDisplay": {
        "type": "Compose",
        "inputs": "@if(empty(trim(coalesce(triggerBody()?['text_2'], ''))), '', formatDateTime(triggerBody()?['text_2'], 'd MMM yyyy'))",
        "runAfter": { "NZ03_Compose_SectionName": ["SUCCEEDED"] }
      },
      "NZ05_Compose_PageTitle": {
        "type": "Compose",
        "inputs": "@concat(if(empty(outputs('NZ04_Compose_OccurrenceDateDisplay')), '', concat(outputs('NZ04_Compose_OccurrenceDateDisplay'), ' - ')), if(empty(trim(coalesce(triggerBody()?['text'], ''))), 'Untitled Meeting', substring(replace(replace(replace(replace(coalesce(triggerBody()?['text'], ''), '&', 'and'), '<', ''), '>', ''), '\"', ''), 0, min(150, length(replace(replace(replace(replace(coalesce(triggerBody()?['text'], ''), '&', 'and'), '<', ''), '>', ''), '\"', ''))))))",
        "runAfter": { "NZ04_Compose_OccurrenceDateDisplay": ["SUCCEEDED"] }
      },
      "NZ06_Compose_LegacyPageTitle": {
        "type": "Compose",
        "inputs": "@concat(if(empty(trim(coalesce(triggerBody()?['text'], ''))), 'Untitled Meeting', substring(replace(replace(replace(replace(coalesce(triggerBody()?['text'], ''), '&', 'and'), '<', ''), '>', ''), '\"', ''), 0, min(150, length(replace(replace(replace(replace(coalesce(triggerBody()?['text'], ''), '&', 'and'), '<', ''), '>', ''), '\"', ''))))), if(empty(outputs('NZ04_Compose_OccurrenceDateDisplay')), '', concat(' - ', outputs('NZ04_Compose_OccurrenceDateDisplay'))))",
        "runAfter": { "NZ05_Compose_PageTitle": ["SUCCEEDED"] }
      },
      "NZ07_Compose_PageHtmlDocument": {
        "type": "Compose",
        "inputs": "@concat('<html><head><title>', outputs('NZ05_Compose_PageTitle'), '</title></head><body>', coalesce(triggerBody()?['text_3'], ''), '</body></html>')",
        "runAfter": { "NZ06_Compose_LegacyPageTitle": ["SUCCEEDED"] }
      },
      "NZ08_Compose_UpdateHtmlFragment": {
        "type": "Compose",
        "inputs": "@concat('<hr><h2>Automated update</h2><p><strong>Updated by:</strong> Meeting Capture Agent</p><p><strong>Update note:</strong> Meeting details were refreshed by the automation. Existing human-entered notes were preserved below.</p>', coalesce(triggerBody()?['text_3'], ''))",
        "runAfter": { "NZ07_Compose_PageHtmlDocument": ["SUCCEEDED"] }
      },
      "NZ09_Compose_NotebookPath": {
        "type": "Compose",
        "inputs": "Meeting Notes|$|https://jsainsbury-my.sharepoint.com/personal/david_croxson_sainsburys_co_uk/Documents/Meeting Notes",
        "runAfter": { "NZ08_Compose_UpdateHtmlFragment": ["SUCCEEDED"] }
      },
      "NZ10_Compose_Inputs_Valid": {
        "type": "Compose",
        "inputs": "@and(not(empty(trim(coalesce(triggerBody()?['text_2'], '')))), not(empty(trim(coalesce(outputs('NZ02_Compose_MappingKey'), '')))))",
        "runAfter": { "NZ09_Compose_NotebookPath": ["SUCCEEDED"] }
      }
    },
    "runAfter": {}
  },
  "Scope_MappingLookup": {
    "type": "Scope",
    "actions": {
      "ML01_Get_Mapping_Items": {
        "type": "OpenApiConnection",
        "inputs": {
          "parameters": {
            "dataset": "https://jsainsbury.sharepoint.com/sites/coplt",
            "table": "186b3c9f-e758-4e85-83d5-685946614a0a",
            "$filter": "@if(equals(outputs('NZ01_Compose_IsRecurring'), 'true'), concat('SeriesMasterId eq ''', outputs('NZ02_Compose_MappingKey'), ''' and OccurrenceDate eq ''', triggerBody()?['text_2'], ''''), concat('MeetingId eq ''', outputs('NZ02_Compose_MappingKey'), ''' and OccurrenceDate eq ''', triggerBody()?['text_2'], ''''))",
            "$top": 2
          },
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "connection": "shared_sharepointonline",
            "operationId": "GetItems"
          }
        }
      },
      "ML02_Compose_Match_Count": {
        "type": "Compose",
        "inputs": "@length(body('ML01_Get_Mapping_Items')?['value'])",
        "runAfter": { "ML01_Get_Mapping_Items": ["SUCCEEDED"] }
      },
      "ML03_Compose_Mapping_Exists": {
        "type": "Compose",
        "inputs": "@greater(outputs('ML02_Compose_Match_Count'), 0)",
        "runAfter": { "ML02_Compose_Match_Count": ["SUCCEEDED"] }
      },
      "ML04_Compose_Mapping_Row_Count_Diagnostic": {
        "type": "Compose",
        "inputs": "@string(outputs('ML02_Compose_Match_Count'))",
        "runAfter": { "ML03_Compose_Mapping_Exists": ["SUCCEEDED"] }
      }
    },
    "runAfter": { "Scope_Normalize": ["SUCCEEDED"] }
  },
  "Scope_MappingWrite": {
    "type": "Scope",
    "actions": {
      "Condition_Mapping_Exists": {
        "type": "If",
        "expression": {
          "and": [{ "equals": ["@outputs('ML03_Compose_Mapping_Exists')", true] }]
        },
        "actions": {
          "EM01_Compose_Existing_Row_Id": {
            "type": "Compose",
            "inputs": "@string(first(body('ML01_Get_Mapping_Items')?['value'])?['ID'])"
          },
          "EM02_Compose_Existing_Page_Self_Url": {
            "type": "Compose",
            "inputs": "@coalesce(first(body('ML01_Get_Mapping_Items')?['value'])?['PageSelfUrl'], '')",
            "runAfter": { "EM01_Compose_Existing_Row_Id": ["SUCCEEDED"] }
          },
          "EM03_Compose_Existing_Page_Web_Url": {
            "type": "Compose",
            "inputs": "@coalesce(first(body('ML01_Get_Mapping_Items')?['value'])?['PageWebUrl'], '')",
            "runAfter": { "EM02_Compose_Existing_Page_Self_Url": ["SUCCEEDED"] }
          },
          "EM04_Compose_Existing_Section_Pages_Url": {
            "type": "Compose",
            "inputs": "@coalesce(first(body('ML01_Get_Mapping_Items')?['value'])?['SectionPagesUrl'], '')",
            "runAfter": { "EM03_Compose_Existing_Page_Web_Url": ["SUCCEEDED"] }
          }
        },
        "else": {
          "actions": {
            "NM01_Create_Mapping_Item": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "https://jsainsbury.sharepoint.com/sites/coplt",
                  "table": "186b3c9f-e758-4e85-83d5-685946614a0a",
                  "item/Title": "Mapping",
                  "item/SeriesMasterId": "@triggerBody()?['text_1']",
                  "item/MeetingTitle": "@triggerBody()?['text']",
                  "item/SectionDisplayName": "@outputs('NZ03_Compose_SectionName')",
                  "item/NotebookName": "Meeting Notes",
                  "item/Status/Value": "Active",
                  "item/MeetingId": "@triggerBody()?['text_6']",
                  "item/OccurrenceDate": "@triggerBody()?['text_2']",
                  "item/JoinUrl": "@trim(coalesce(triggerBody()?['text_5'], ''))",
                  "item/ChatCaptured": false,
                  "item/EndTime": "@coalesce(triggerBody()?['text_4'], '')",
                  "item/RecapCaptured": false
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connection": "shared_sharepointonline",
                  "operationId": "PostItem"
                }
              }
            },
            "NM02_Compose_New_Row_Id": {
              "type": "Compose",
              "inputs": "@string(outputs('NM01_Create_Mapping_Item')?['body/ID'])",
              "runAfter": { "NM01_Create_Mapping_Item": ["SUCCEEDED"] }
            },
            "NM03_Compose_New_Row_Created": {
              "type": "Compose",
              "inputs": "@if(equals(outputs('NM01_Create_Mapping_Item')?['statusCode'], 201), 'true', 'false')",
              "runAfter": { "NM02_Compose_New_Row_Id": ["SUCCEEDED"] }
            }
          }
        }
      }
    },
    "runAfter": { "Scope_MappingLookup": ["SUCCEEDED"] }
  },
  "Respond_Stub_Stage1": {
    "type": "Response",
    "kind": "PowerApp",
    "inputs": {
      "schema": {
        "type": "object",
        "properties": {
          "outstatus": { "title": "outstatus", "type": "string", "x-ms-content-hint": "TEXT", "x-ms-dynamically-added": true },
          "outcreatedpagelink": { "title": "outcreatedpagelink", "type": "string", "x-ms-content-hint": "TEXT", "x-ms-dynamically-added": true },
          "outpageaction": { "title": "outpageaction", "type": "string", "x-ms-content-hint": "TEXT", "x-ms-dynamically-added": true }
        },
        "additionalProperties": {}
      },
      "statusCode": 200,
      "body": {
        "outstatus": "STAGE1_TEST",
        "outcreatedpagelink": "@{coalesce(outputs('EM01_Compose_Existing_Row_Id'), outputs('NM02_Compose_New_Row_Id'), 'NO_ROW_ID')}",
        "outpageaction": "@{outputs('ML04_Compose_Mapping_Row_Count_Diagnostic')}"
      }
    },
    "runAfter": { "Scope_MappingWrite": ["SUCCEEDED"] }
  }
}
